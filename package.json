{
  "name": "firma-sri",
  "version": "1.0.0",
  "description": "Firma electrónica XAdES-BES de comprobantes electrónicos del SRI de Ecuador con un certificado .p12, y verificación de la firma. Sign and verify Ecuador SRI electronic invoices (XAdES-BES). TypeScript.",
  "keywords": [
    "comprobantes electronicos",
    "ecuador",
    "electronic invoice",
    "factura electronica",
    "facturacion electronica",
    "firma",
    "firma digital",
    "firma electronica",
    "firma electrónica",
    "firma sri",
    "firmar xml",
    "p12",
    "pkcs12",
    "sri",
    "sri ecuador",
    "typescript",
    "xades",
    "xades-bes",
    "xml signature",
    "xmldsig"
  ],
  "homepage": "https://github.com/bayasdev/firma-sri#readme",
  "bugs": {
    "url": "https://github.com/bayasdev/firma-sri/issues"
  },
  "license": "Apache-2.0",
  "author": "Victor Bayas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayasdev/firma-sri.git"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check && knip",
    "check-types": "tsc",
    "check-package": "publint && attw --pack . --profile esm-only",
    "fix": "ultracite fix",
    "test": "vitest run",
    "prepublishOnly": "pnpm check && pnpm check-types && pnpm test && pnpm build && pnpm check-package"
  },
  "dependencies": {
    "@xmldom/is-dom-node": "^1.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "node-forge": "^1.4.3",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@hegeldev/hegel": "0.5.3",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "knip": "6.44.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0",
    "xmllint-wasm": "5.3.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.15.0"
}
